// 1. Konfiguration des Generators (erzeugt den TypeScript Client)
generator client {
  provider = "prisma-client-js"
}

// 2. Datenbank-Verbindung
datasource db {
  provider = "postgresql"
}

// 3. Datenmodelle (Tabellen)
model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}