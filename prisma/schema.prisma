//Konfiguration des Generators (erzeugt den TypeScript Client)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//Expert*innen
model Expert {
  expert_id     Int                @id @default(autoincrement())
  name          String
  prename       String
  title         String?
  email         String?            @unique
  description   String?
  location      String?
  network       String?
  last_contact  DateTime           @default(now())

  primary_organization Int?
}

//Beschäftigung & Organisationen
model Organization {
  organization_id Int       @id @default(autoincrement())
  name          String
  location      String?
  field         String?
  description   String?
  
}

model ExpertField {
  expert_id   Int           @id @default(autoincrement())
  field       String
  description String?
  economic    Boolean @default(false)
  science     Boolean @default(false)
  social      Boolean @default(false)

}

model Project {
  id          Int               @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  state       String?   // z.B. "Sandbox", "Challenge"
  lastUpdate  DateTime  @updatedAt
  location    String?
  websiteUrl  String?
  details     String?    // 1:1 Beziehung zu den Details
}

model ProjectRelation {
  projectId Int
  expertId  Int
  problemId Int?

  @@id([projectId, expertId])
}

//TODO
model Problem {
  id          Int               @id @default(autoincrement())
  expertId    Int               // Der Ersteller/Besitzer
  title       String
  description String?

}