// generator and datasource remain the same
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Expert model
model Expert {
  expert_id    Int      @id @default(autoincrement())
  name         String
  prename      String
  title        String?
  email        String?  @unique
  description  String?
  location     String?
  network      String?
  last_contact DateTime @default(now())

  // RELATION: Primary Organization
  // 1. The scalar field (the ID in the DB)
  primary_organization_id Int
  // 2. The relation field (virtual)
  primary_organization    Organization @relation(fields: [primary_organization_id], references: [organization_id])

  // BACK-RELATIONS (Needed for Prisma to map the connections)
  expert_fields    ExpertField[]
  problems         Problem[]
  projectRelations ProjectRelation[]
}

// Organization model
model Organization {
  organization_id Int      @id @default(autoincrement())
  name            String
  location        String?
  field           String?
  description     String?
  
  // Back-relation for Expert
  experts         Expert[]
}

model ExpertField {
  id          Int     @id @default(autoincrement()) // Every model needs an ID
  expert_id   Int
  field       String
  description String?
  economic    Boolean @default(false)
  science     Boolean @default(false)
  social      Boolean @default(false)

  expert      Expert  @relation(fields: [expert_id], references: [expert_id])
}

model Project {
  id          Int               @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  state       String?
  lastUpdate  DateTime          @updatedAt
  location    String?
  websiteUrl  String?
  details     String?
  
  // Back-relation
  relations   ProjectRelation[]
}

model ProjectRelation {
  projectId Int
  expertId  Int
  problemId Int? // Optional if not every relation needs a problem

  project   Project @relation(fields: [projectId], references: [id])
  expert    Expert  @relation(fields: [expertId], references: [expert_id])
  problem   Problem? @relation(fields: [problemId], references: [id])

  @@id([projectId, expertId]) // Composite Primary Key for join table
}

model Problem {
  id          Int      @id @default(autoincrement())
  expertId    Int
  title       String
  description String?

  expert      Expert   @relation(fields: [expertId], references: [expert_id])
  projectRelations ProjectRelation[]
}

model Test {
  title   String    @id
  content String
}
