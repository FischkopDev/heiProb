generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Expert {
  expert_id               Int               @id @default(autoincrement())
  name                    String
  prename                 String
  title                   String?
  email                   String?           @unique
  description             String?
  location                String?
  network                 String?
  last_contact            DateTime          @default(now())
  primary_organization_id Int
  primary_organization    Organization      @relation(fields: [primary_organization_id], references: [organization_id])
  expert_fields           ExpertField[]
  problems                Problem[]
  projectRelations        ProjectRelation[]
}

model Organization {
  organization_id Int      @id @default(autoincrement())
  name            String
  location        String?
  field           String?
  description     String?
  experts         Expert[]
}

model ExpertField {
  id          Int     @id @default(autoincrement())
  expert_id   Int
  field       String
  description String?
  economic    Boolean @default(false)
  science     Boolean @default(false)
  social      Boolean @default(false)
  expert      Expert  @relation(fields: [expert_id], references: [expert_id])
}

model Project {
  id          Int               @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  state       String?
  lastUpdate  DateTime          @updatedAt
  location    String?
  websiteUrl  String?
  details     String?
  relations   ProjectRelation[]
}

model ProjectRelation {
  projectId Int
  expertId  Int
  problemId Int?
  expert    Expert   @relation(fields: [expertId], references: [expert_id])
  problem   Problem? @relation(fields: [problemId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])

  @@id([projectId, expertId])
}

model Problem {
  id               Int               @id @default(autoincrement())
  expertId         Int
  title            String
  description      String?
  expert           Expert            @relation(fields: [expertId], references: [expert_id])
  projectRelations ProjectRelation[]
}

model Test {
  title   String @id
  content String
}
