        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Challenge {\n        -string _id\n        -string _title\n        -string _department\n        -string _status\n        +string id\n        +string title\n        +string department\n        +string status\n        +Challenge(&lt;br&gt;&amp;nbsp;&amp;nbsp;id: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;title: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;department: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;status: string&lt;br&gt;)\n    }\n\n    class Project {\n        -string _id\n        -string _title\n        -string _stage\n        -string _topics\n        -string _location\n        -string[] _actors\n        -string _value\n        +string id\n        +string title\n        +string stage\n        +string topics\n        +string location\n        +string[] actors\n        +string value\n        +Project(&lt;br&gt;&amp;nbsp;&amp;nbsp;id: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;title: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;stage: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;topics: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;location: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;actors: string[],&lt;br&gt;&amp;nbsp;&amp;nbsp;value: string&lt;br&gt;)\n    }\n\n    class Expert {\n        -string _id\n        -string _name\n        -string _role\n        -string[] _skills\n        +string id\n        +string name\n        +string role\n        +string[] skills\n        +Expert(&lt;br&gt;&amp;nbsp;&amp;nbsp;id: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;name: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;role: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;skills: string[]&lt;br&gt;)\n    }\n\n    class ProblemItem {\n        -number _id\n        -number _problem_id\n        -string _title\n        -string _tags\n        -string _category\n        -string _status\n        -string _statusColor\n        -string _description\n        -string _summary\n        -string _impact\n        -string _stakeholders\n        -string _nextSteps\n        +number id\n        +number problem_id\n        +string title\n        +string tags\n        +string category\n        +string status\n        +string statusColor\n        +string description\n        +string summary\n        +string impact\n        +string stakeholders\n        +string nextSteps\n        +ProblemItem(&lt;br&gt;&amp;nbsp;&amp;nbsp;title: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;category: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;status: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;statusColor: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;id: number,&lt;br&gt;&amp;nbsp;&amp;nbsp;problem_id: number,&lt;br&gt;&amp;nbsp;&amp;nbsp;tags: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;description: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;summary: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;impact: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;stakeholders: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;nextSteps: string&lt;br&gt;)\n    }\n\n    class ProjectMember {\n        -string _id\n        -number _expertId\n        -string _name\n        -string _role\n        +string id\n        +number expertId\n        +string name\n        +string role\n        +ProjectMember(&lt;br&gt;&amp;nbsp;&amp;nbsp;id: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;name: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;role: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;expertId: number&lt;br&gt;)\n    }\n\n    class ExpertOption {\n        -any _id\n        -string _name\n        +any id\n        +string name\n        +ExpertOption(&lt;br&gt;&amp;nbsp;&amp;nbsp;id: any,&lt;br&gt;&amp;nbsp;&amp;nbsp;name: string&lt;br&gt;)\n    }\n\n    class NewProject {\n        -string _title\n        -string _description\n        -string _startDate\n        -string _endDate\n        -string _state\n        -string _location\n        -string _websiteUrl\n        -string _details\n        -ProjectMember[] _members\n        +string title\n        +string description\n        +string startDate\n        +string endDate\n        +string state\n        +string location\n        +string websiteUrl\n        +string details\n        +ProjectMember[] members\n        +NewProject(&lt;br&gt;&amp;nbsp;&amp;nbsp;title: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;description: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;startDate: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;endDate: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;state: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;location: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;websiteUrl: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;details: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;members: ProjectMember[]&lt;br&gt;)\n    }\n\n    class ProjectDetails {\n        -string _id\n        -string _title\n        -string _description\n        -string _startDate\n        -string _endDate\n        -string _state\n        -string _project_state\n        -string _location\n        -string _websiteUrl\n        -string _details\n        -ProjectMember[] _experts\n        +string id\n        +string title\n        +string description\n        +string startDate\n        +string endDate\n        +string state\n        +string project_state\n        +string location\n        +string websiteUrl\n        +string details\n        +ProjectMember[] experts\n        +ProjectDetails(&lt;br&gt;&amp;nbsp;&amp;nbsp;id: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;title: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;description: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;startDate: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;endDate: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;state: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;location: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;websiteUrl: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;details: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;experts: ProjectMember[],&lt;br&gt;&amp;nbsp;&amp;nbsp;project_state: string&lt;br&gt;)\n    }\n\n    class AddExpertViewProps {\n        &lt;&lt;interface&gt;&gt;\n        +onSave(formData: ExpertFormData) void\n        +onCancel() void\n    }\n\n    class ExpertFormData {\n        -string _name\n        -string _prename\n        -string _title\n        -string _primary_organization\n        -string _other_organizations\n        -string _scientificAreas\n        -string _email\n        -string _phone\n        -string _last_contact\n        -string _description\n        -string _expert_fields\n        -boolean _economic\n        -boolean _science\n        -boolean _social\n        +string name\n        +string prename\n        +string title\n        +string primary_organization\n        +string other_organizations\n        +string scientificAreas\n        +string email\n        +string phone\n        +string last_contact\n        +string description\n        +string expert_fields\n        +boolean economic\n        +boolean science\n        +boolean social\n        +ExpertFormData(&lt;br&gt;&amp;nbsp;&amp;nbsp;name: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;prename: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;title: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;primary_organization: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;other_organizations: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;scientificAreas: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;email: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;phone: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;description: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;expert_fields: string,&lt;br&gt;&amp;nbsp;&amp;nbsp;economic: boolean,&lt;br&gt;&amp;nbsp;&amp;nbsp;science: boolean,&lt;br&gt;&amp;nbsp;&amp;nbsp;social: boolean,&lt;br&gt;&amp;nbsp;&amp;nbsp;last_contact: string&lt;br&gt;)\n    }\n\n    class Organization {\n        -number _id\n        -string _name\n        +number id\n        +string name\n        +Organization(&lt;br&gt;&amp;nbsp;&amp;nbsp;id: number,&lt;br&gt;&amp;nbsp;&amp;nbsp;name: string&lt;br&gt;)\n    }\n\n    %% Beziehungen (Relationships)\n    NewProject \&quot;1\&quot; *-- \&quot;0..*\&quot; ProjectMember : enthält (members)\n    ProjectDetails \&quot;1\&quot; *-- \&quot;0..*\&quot; ProjectMember : besitzt (experts)\n    ProjectMember \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; Expert : referenziert (expertId)\n    AddExpertViewProps ..&gt; ExpertFormData : nutzt (onSave)&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="MBQmmkvFcaw5QykVfjwD-437">
